RichnessTableOnlyPlant[i,]<- rowSums(ifelse(Subsample>0,1,0))
PielouTableOnlyPlant[i,]<- ShannonTableOnlyPlant[i,]/log(RichnessTableOnlyPlantt[i,])
}
for (i in 1:nrow(ShannonTableOnlyPlant)){
